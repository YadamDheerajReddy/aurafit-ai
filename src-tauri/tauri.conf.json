{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuraFit AI",
  "version": "0.3.1",
  "identifier": "com.aurafit.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AuraFit AI",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; connect-src 'self' http://localhost:11434 ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": { "width": 660, "height": 450 },
        "appPosition": { "x": 180, "y": 250 },
        "applicationFolderPosition": { "x": 480, "y": 250 }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGNDY4Q0YxNDkzOTMwNjQKUldSa01EbEo4WXhHWDVLSXArZkZmUkpDbk8yRkthQmttS1VQcjdYV0N5SjdZSUdrdFVTUlJtUEwK",
      "endpoints": [
        "https://github.com/YadamDheerajReddy/aurafit-ai/releases/latest/download/latest.json"
      ]
    }
  }
}
